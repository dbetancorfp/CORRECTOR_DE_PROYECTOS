{
  "name": "corrector-de-proyectos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test --max-workers=1",
    "start": "bun run corrector/05-implementation/backend/src/index.ts",
    "build": "bun build corrector/05-implementation/frontend/src/index.ts --outdir corrector/05-implementation/frontend/dist --target browser && bun run build:css",
    "build:css": "cd corrector/05-implementation/frontend && bunx tailwindcss -i src/styles/tailwind.css -o dist/tailwind.css --minify",
    "db:setup": "bun run corrector/05-implementation/backend/scripts/setup-db.ts",
    "db:seed:e2e": "bun run corrector/05-implementation/backend/scripts/seed-e2e.ts",
    "start:e2e": "PORT=7777 DATA_BACKEND=postgres bun run corrector/05-implementation/backend/src/index.ts",
    "cypress:open": "cypress open --config-file corrector/05-implementation/frontend/cypress.config.ts",
    "cypress:run": "cypress run --config-file corrector/05-implementation/frontend/cypress.config.ts",
    "pree2e": "bun run build && bun run db:seed:e2e",
    "e2e": "start-server-and-test start:e2e http://localhost:7777 cypress:run",
    "agent:designer-front": "bun cli/index.js run-agent designer-front --feature-id corrector-v1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "lit-html": "^3.3.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "autoprefixer": "^10.5.3",
    "bun-types": "^1.3.14",
    "cypress": "^15.18.1",
    "postcss": "^8.5.19",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^3",
    "typescript": "^6.0.3"
  }
}
