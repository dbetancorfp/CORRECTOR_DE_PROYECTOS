{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true
  },
  "include": [
    "corrector/05-implementation/backend/**/*.ts",
    "corrector/05-implementation/frontend/src/**/*.ts",
    "corrector/05-implementation/shared/**/*.ts",
    "lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "corrector/05-implementation/frontend/dist",
    "corrector/05-implementation/frontend/cypress"
  ]
}
